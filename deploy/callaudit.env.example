# Copy to /etc/callaudit.env (chmod 600, owned by root) and fill in.
CALL_AUDIT_PORT=8770
# Long random string, e.g. output of: openssl rand -hex 32
CALL_AUDIT_SECRET=
CALL_AUDIT_USERS=/opt/callaudit/users.json
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=callaudit
MYSQL_PASS=
MYSQL_DB=call_audit
